
char securityCode[5];
const char authorizedCode[] = "2580";

bool invalidInput = false;
int codeLength = 0;

void showWelcome();
bool readSecurityCode();
bool validateCode();
void displayResult(bool inputValid, bool codeCorrect);

void setup()
{
    Serial.begin(9600);
    showWelcome();
}

void loop()
{
    bool inputValid;
    bool codeCorrect;

    inputValid = readSecurityCode();
    codeCorrect = validateCode();

    displayResult(inputValid, codeCorrect);

    delay(500);
}

void showWelcome()
{
    Serial.println("================================");
    Serial.println(" SECURE DIGITAL ACCESS SYSTEM");
    Serial.println("================================");
    Serial.println("Enter your 4-digit security code.");
    Serial.println("Authorized code: Do not display.");
}

bool readSecurityCode()
{
    while (Serial.available() > 0)
    {
        Serial.read();
    }

    Serial.println();
    Serial.print("Enter your 4-digit security code: ");

    codeLength = 0;
    invalidInput = false;

    while (true)
    {
        while (Serial.available() == 0)
        {
        }

        char character = Serial.read();

        if (character == '\r')
        {
            continue;
        }

        if (character == '\n')
        {
            break;
        }

        if (character >= '0' && character <= '9')
        {
            Serial.print('*');

            if (codeLength < 4)
            {
                securityCode[codeLength] = character;
            }

            codeLength++;
        }
        else
        {
            invalidInput = true;
        }
    }

    Serial.println();

    if (codeLength != 4)
    {
        invalidInput = true;
    }

    if (invalidInput)
    {
        return false;
    }

    securityCode[4] = '\0';
    return true;
}

bool validateCode()
{
    if (invalidInput || codeLength != 4)
    {
        return false;
    }

    return strcmp(securityCode, authorizedCode) == 0;
}

void displayResult(bool inputValid, bool codeCorrect)
{
    if (!inputValid)
    {
        Serial.println("Invalid code! Enter exactly 4 digits (0-9).");
    }
    else if (codeCorrect)
    {
        Serial.println("Access granted! Welcome.");
    }
    else
    {
        Serial.println("Access denied! Incorrect code.");
    }

    Serial.println("You can try again.");
}
